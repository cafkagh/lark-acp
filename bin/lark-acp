#!/usr/bin/env bash
# lark-acp launcher
#
# Responsibilities:
# - Self-locate the project dir from this script's own path (works from
#   install location, symlink, or direct invocation).
# - Load .env from a single canonical location: $LARK_ACP_HOME/.env
#   (default ~/.lark-acp/.env). On first run, migrate any legacy .env from
#   $PWD or $PROJECT_ROOT into the canonical location, then ignore the
#   legacy ones.
# - Auto-restart when the bot exits with code 99 (used for /restart).
# - Exit immediately on any other exit code (error surfaces clearly).

set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
# Project root (where node_modules + src live). Independent of BOT_HOME, which
# is a separate user-state directory (~/.lark-acp by default).
PROJECT_ROOT="${LARK_ACP_PROJECT_ROOT:-$(cd "$BIN_DIR/.." && pwd)}"

# Canonical state directory. Mirrors src/config.ts BOT_HOME.
LARK_ACP_HOME="${LARK_ACP_HOME:-$HOME/.lark-acp}"
mkdir -p "$LARK_ACP_HOME"
CANONICAL_ENV="$LARK_ACP_HOME/.env"
WRAPPER_LOG="$LARK_ACP_HOME/lark-acp.log"

# log_msg: emit to both stderr (for live tail) and the persistent wrapper log.
log_msg() {
  local line
  line="[lark-acp wrapper $(date '+%Y-%m-%d %H:%M:%S')] $*"
  echo "$line" >&2
  echo "$line" >> "$WRAPPER_LOG" 2>/dev/null || true
}

load_env() {
  local f="$1"
  [ -f "$f" ] || return 0
  # shellcheck disable=SC1090
  set -a; . "$f"; set +a
}

# One-time migration: if canonical doesn't exist, search legacy locations in
# priority order ($PWD/.env first, then $PROJECT_ROOT/.env) and move the first
# match into the canonical location. Subsequent runs only read the canonical
# file; legacy files are warned about but ignored.
if [ ! -f "$CANONICAL_ENV" ]; then
  legacy_candidates=()
  [ -f "$PWD/.env" ] && legacy_candidates+=("$PWD/.env")
  if [ -f "$PROJECT_ROOT/.env" ] && [ "$PROJECT_ROOT/.env" != "$PWD/.env" ]; then
    legacy_candidates+=("$PROJECT_ROOT/.env")
  fi
  if [ "${#legacy_candidates[@]}" -gt 0 ]; then
    src="${legacy_candidates[0]}"
    log_msg "migrating legacy .env: $src -> $CANONICAL_ENV"
    if mv "$src" "$CANONICAL_ENV" 2>/dev/null; then
      log_msg "migration complete; legacy file removed"
    else
      log_msg "WARN: mv failed, falling back to copy"
      if cp "$src" "$CANONICAL_ENV" 2>/dev/null; then
        log_msg "copied $src -> $CANONICAL_ENV; please remove $src manually"
      else
        log_msg "ERROR: could not migrate $src to $CANONICAL_ENV; loading from legacy this run"
        load_env "$src"
      fi
    fi
    # Note any extra legacy locations we didn't touch.
    for extra in "${legacy_candidates[@]:1}"; do
      log_msg "NOTE: additional legacy .env at $extra is now ignored; remove it to silence this warning"
    done
  fi
fi

# Stale-file warning: if canonical exists AND any legacy file still hangs
# around, the legacy one is dead — flag it once per launch.
if [ -f "$CANONICAL_ENV" ]; then
  for stale in "$PWD/.env" "$PROJECT_ROOT/.env"; do
    if [ -f "$stale" ] && [ "$stale" != "$CANONICAL_ENV" ]; then
      log_msg "NOTE: $stale is no longer used; canonical config is $CANONICAL_ENV — please remove the stale file"
    fi
  done
fi

if [ ! -f "$CANONICAL_ENV" ]; then
  log_msg "no .env found; create $CANONICAL_ENV with your bot credentials (see .env.example)"
fi

TSX="$PROJECT_ROOT/node_modules/.bin/tsx"
ENTRY="$PROJECT_ROOT/src/index.ts"

if [ ! -x "$TSX" ]; then
  echo "[lark-acp] tsx not found at $TSX" >&2
  echo "[lark-acp] did you run 'npm install' in $PROJECT_ROOT?" >&2
  exit 127
fi
if [ ! -f "$ENTRY" ]; then
  echo "[lark-acp] entry not found at $ENTRY" >&2
  exit 127
fi

set +e
while true; do
  load_env "$CANONICAL_ENV"
  "$TSX" "$ENTRY" "$@"
  rc=$?
  if [ "$rc" -ne 99 ]; then
    exit "$rc"
  fi
  echo "[lark-acp wrapper] restarting (rc=99)..." >&2
  sleep 1
done
